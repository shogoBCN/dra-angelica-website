# Copy to .env.local and fill in values. Never commit .env.local.
# https://aistudio.google.com/apikey

GEMINI_API_KEY=

GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-flash-latest
# Cheap drafts: gemini-2.5-flash-image (~$0.04/img)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Better drafts: gemini-3.1-flash-image / Nano Banana 2 (~$0.07/img). Pass --model gemini-3.1-flash-image

# Premium finals: gemini-3-pro-image-preview (~$0.13/img at 2K). Pass --pro to script.
GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image-preview
GEMINI_IMAGE_SIZE=2K

# Music: lyria-3-pro-preview (~35s, matches slideshow) or lyria-3-clip-preview (30s fixed)
GEMINI_MUSIC_MODEL=lyria-3-pro-preview
